{
  "name": "quantdca",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal dashboard for backtesting and comparing DCA strategies with EODHD market data.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:e2e": "node scripts/dev.mjs --mock-data",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "preview": "npm run build && node dist-server/server/index.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && npm run test:e2e",
    "prepush": "node scripts/pre-push.mjs",
    "prepush:full": "node scripts/pre-push.mjs --full",
    "prepush:quick": "node scripts/pre-push.mjs",
    "audit:prod": "npm audit --omit=dev",
    "hooks:install": "node scripts/install-git-hooks.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}

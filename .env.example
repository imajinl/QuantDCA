# Server-only market data key. Do not prefix with VITE_ and do not expose it to the browser.
EODHD_API_KEY=

# Optional local server overrides.
# QDCA_API_PORT=8787
# QDCA_WEB_PORT=5173
# QDCA_MAX_REQUEST_BYTES=2000000

# Optional production server overrides. Keep HOST unset or 127.0.0.1 locally.
# HOST=127.0.0.1
# PORT=8787

# Test-only switches.
# QDCA_USE_MOCK_DATA=false
# QDCA_RUN_LIVE_TESTS=0

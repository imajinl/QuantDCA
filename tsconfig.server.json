{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "noEmit": false,
    "outDir": "dist-server",
    "declaration": false,
    "sourceMap": true,
    "types": ["node"]
  },
  "include": ["src/lib/**/*.ts", "src/server/**/*.ts"],
  "exclude": ["src/**/*.test.ts"]
}
